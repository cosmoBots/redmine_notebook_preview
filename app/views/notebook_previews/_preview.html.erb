<% export = local_assigns.fetch(:export, nil) %>
<div class="notebook-preview-wrapper" id="<%= notebook_preview_container_id(attachment) %>">

  <%# The cosmoSys report leaves the filename out: the item already titles it. %>
  <% if local_assigns.fetch(:show_filename, true) %>
    <div class="notebook-preview-header">
      <span class="notebook-preview-filename"><%= attachment.filename %></span>
    </div>
  <% end %>

  <% status = notebook_preview_status(attachment) %>

  <% if status == :ok %>
    <% if notebook_preview_dynamic?(attachment) %>
      <div class="notebook-preview-dynamic">
        <p class="icon icon-warning">
          <%= l(:notice_notebook_preview_dynamic) %>
        </p>
      </div>
    <% else %>
      <div class="notebook-preview-content redmine-latex-content">
        <%= notebook_preview_html(attachment, export: export).html_safe %>
      </div>
    <% end %>

  <% elsif status == :error %>
    <div class="notebook-preview-error" id="<%= notebook_preview_error_container_id(attachment) %>">
      <p class="icon icon-warning">
        <%= l(:error_notebook_preview_failed) %>
      </p>
      <pre class="notebook-preview-error-detail"><%= notebook_preview_error(attachment) %></pre>
      <% if !notebook_preview_export?(export) && can_regenerate_notebook_preview?(attachment) %>
        <%= render partial: 'notebook_previews/regenerate_button', locals: { attachment: attachment } %>
      <% end %>
    </div>

  <% else %>
    <div class="notebook-preview-none">
      <p class="icon icon-warning">
        <%= l(:notice_notebook_preview_unavailable) %>
      </p>
      <% if !notebook_preview_export?(export) && can_regenerate_notebook_preview?(attachment) %>
        <%= render partial: 'notebook_previews/regenerate_button', locals: { attachment: attachment } %>
      <% end %>
    </div>

  <% end %>

</div>
