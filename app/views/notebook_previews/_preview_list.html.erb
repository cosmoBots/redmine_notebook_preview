<% if attachments.any? %>
  <div class="notebook-preview-list">
    <% attachments.each do |attachment| %>
      <%= render partial: 'notebook_previews/preview', locals: { attachment: attachment, export: local_assigns.fetch(:export, nil),
                                                                   show_filename: local_assigns.fetch(:show_filename, true) } %>
    <% end %>
  </div>
<% end %>