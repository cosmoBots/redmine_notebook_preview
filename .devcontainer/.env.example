# Copy this file to .env and fill in your values
# .env is gitignored and should never be committed

# PostgreSQL password (used by both db and redmine services)
DB_PASSWORD=changeme

# Rails secret key base - generate with: openssl rand -hex 64
SECRET_KEY=changeme

# Optional overrides - these are already set in the Dockerfile
# Only needed if you want to change the defaults
# JUPYTER_BIN=/opt/nbconvert-env/bin/jupyter
# NOTEBOOK_CACHE_DIR=/usr/src/redmine/notebook_cache